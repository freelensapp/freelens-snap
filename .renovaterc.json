{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "ignoreDeps: ubuntu runners must stay on the oldest supported version, which also matches the core24 base of the snap."
  ],
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "addLabels": ["renovate"],
  "ignoreDeps": ["ubuntu"],
  "customManagers": [
    {
      "description": "Renovate hints after a comment: `# datasource=<datasource> depName=<depName>`.",
      "customType": "regex",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^\\.trunk/trunk\\.yaml$/",
        "/^snapcraft\\.yaml$/"
      ],
      "matchStrings": [
        "(\\s+|.*?@)(?<currentValue>\\S+)\\s*#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
